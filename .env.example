# Copy to .env and adjust as needed. Every variable has a working default.

# --- Valhalla routing data -------------------------------------------------
# OSM extract(s) downloaded on first start. Space-separated Geofabrik URLs.
# Default is England. For the whole of the UK use:
#   https://download.geofabrik.de/europe/united-kingdom-latest.osm.pbf
# For fast dev iteration pick a small region, e.g.:
#   https://download.geofabrik.de/europe/united-kingdom/england/west-yorkshire-latest.osm.pbf
VALHALLA_TILE_URL=https://download.geofabrik.de/europe/united-kingdom/england-latest.osm.pbf

# Download elevation data and build hill-aware routing + elevation profiles.
# Set to False to skip (faster first build, no elevation chart).
VALHALLA_BUILD_ELEVATION=True

# Threads used for tile building and serving. Defaults to all cores.
#VALHALLA_SERVER_THREADS=4

# --- Place index (optional) ------------------------------------------------
# Place search, POIs and the cycle-network overlay are built from the same
# extract Valhalla downloads, by an opt-in sidecar:
#   docker compose --profile index run --rm indexer
# Until it has run, the app hides those features. Run it after Valhalla has
# finished building, never during a tile build - and again after a data
# refresh, since wiping the tiles volume deletes the extract it reads.
# Both defaults below match the compose service; override only if you have
# moved the extract or need scratch space somewhere other than /tmp.
#OSM_DIR=/custom_files
#WORK_DIR=/tmp

# --- Map tiles -------------------------------------------------------------
# Optional self-hosted CyclOSM raster tile server. Leave unset to use the
# public CyclOSM servers (community-run; can be slow rendering new areas).
# Template must contain {z}/{x}/{y}, e.g.:
#   TILE_URL_CYCLOSM=http://tileserver.lan:8080/tile/{z}/{x}/{y}.png
#TILE_URL_CYCLOSM=

# --- Backend ---------------------------------------------------------------
# Internal URL the backend uses to reach Valhalla (compose service name).
VALHALLA_URL=http://valhalla:8002

# Port the app listens on (prod profile).
APP_PORT=17777

# --- Database and auth -----------------------------------------------------
# Postgres password for the bikegps database user. Change for prod.
POSTGRES_PASSWORD=bikegps

# Allow registrations beyond the first (admin) user. Default false.
SIGNUPS_ENABLED=false

# Set true when the app is served over HTTPS (prod behind a reverse proxy)
# so session cookies are marked Secure.
COOKIE_SECURE=false

# --- Optional OIDC single sign-on ------------------------------------------
# Works with any OIDC provider (Pocket ID, Authelia, Authentik, Keycloak...).
# All three of issuer/client-id/client-secret must be set to enable the
# "Continue with ..." button; unset keeps email+password only.
# External base URL of the app (used for the OIDC redirect URI).
#APP_URL=https://bike.example.com
#OIDC_ISSUER=https://id.example.com
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
#OIDC_PROVIDER_NAME=Pocket ID
# Register the client with callback URL: <APP_URL>/api/auth/oidc/callback
# SSO logins match existing accounts by email; new identities are only
# auto-provisioned when SIGNUPS_ENABLED=true.
# Set false for SSO-only login (hides the password form). Ignored unless
# OIDC is configured, so it can never lock you out.
#PASSWORD_AUTH_ENABLED=true

# --- Wahoo Cloud API (optional) --------------------------------------------
# Register a developer app at https://developers.wahooligan.com (Sandbox
# environment, confidential app) with redirect URI:
#   <APP_URL>/api/wahoo/callback
# Sandbox works fully with your own Wahoo account; production approval is
# only needed when third parties use your instance. Unset hides all Wahoo
# UI and endpoints.
#WAHOO_CLIENT_ID=
#WAHOO_CLIENT_SECRET=

# --- Weather and wind (optional) --------------------------------------------
# Open-Meteo-compatible forecast base URL, e.g.:
#   https://api.open-meteo.com/v1/forecast
# No API key needed for personal use; also works against a self-hosted
# Open-Meteo mirror. Unset hides the weather panel entirely - nothing
# reaches outside the LAN unless this is set.
#WEATHER_API_URL=

# --- AI route assistant (optional) ------------------------------------------
# Any OpenAI-compatible /chat/completions endpoint. Both LLM_BASE_URL and
# LLM_MODEL must be set; unset hides the assistant panel entirely. Your
# route coordinates and OpenStreetMap place names are sent to whatever
# endpoint you configure, so a local model keeps everything on your network.
#
# Local, nothing leaves your network (Ollama, LM Studio):
#   LLM_BASE_URL=http://your-ollama-host:11434/v1
#   LLM_MODEL=qwen3:8b
# Hosted:
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=openai/gpt-5.6-luna
#
# The model MUST support tool calling or the assistant cannot route anything.
#LLM_BASE_URL=
#LLM_MODEL=
# Optional - a local endpoint usually needs no key.
#LLM_API_KEY=
# Optional, OpenRouter only. Comma-separated provider preference, e.g.
# "Fireworks,Together". Which provider serves a model changes both price and
# speed substantially. Sent as a preference with fallbacks left on, never as
# a hard pin: some providers reject mid-conversation tool calls, and a strict
# pin turns that into a failed reply instead of a slower one.
#LLM_PROVIDER_ORDER=
