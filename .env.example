# Copy to .env and adjust as needed. Every variable has a working default.

# --- Valhalla routing data -------------------------------------------------
# OSM extract(s) downloaded on first start. Space-separated Geofabrik URLs.
# Default is England. For the whole of the UK use:
#   https://download.geofabrik.de/europe/united-kingdom-latest.osm.pbf
# For fast dev iteration pick a small region, e.g.:
#   https://download.geofabrik.de/europe/united-kingdom/england/west-yorkshire-latest.osm.pbf
VALHALLA_TILE_URL=https://download.geofabrik.de/europe/united-kingdom/england-latest.osm.pbf

# Download elevation data and build hill-aware routing + elevation profiles.
# Set to False to skip (faster first build, no elevation chart).
VALHALLA_BUILD_ELEVATION=True

# Threads used for tile building and serving. Defaults to all cores.
#VALHALLA_SERVER_THREADS=4

# --- Map tiles -------------------------------------------------------------
# Optional self-hosted CyclOSM raster tile server. Leave unset to use the
# public CyclOSM servers (community-run; can be slow rendering new areas).
# Template must contain {z}/{x}/{y}, e.g.:
#   TILE_URL_CYCLOSM=http://192.168.2.78:8080/tile/{z}/{x}/{y}.png
#TILE_URL_CYCLOSM=

# --- Backend ---------------------------------------------------------------
# Internal URL the backend uses to reach Valhalla (compose service name).
VALHALLA_URL=http://valhalla:8002

# Port the app listens on (prod profile).
APP_PORT=17777
