# Copy to .env and adjust as needed. Every variable has a working default.

# --- Valhalla routing data -------------------------------------------------
# OSM extract(s) downloaded on first start. Space-separated Geofabrik URLs.
# Default is England. For the whole of the UK use:
#   https://download.geofabrik.de/europe/united-kingdom-latest.osm.pbf
# For fast dev iteration pick a small region, e.g.:
#   https://download.geofabrik.de/europe/united-kingdom/england/west-yorkshire-latest.osm.pbf
VALHALLA_TILE_URL=https://download.geofabrik.de/europe/united-kingdom/england-latest.osm.pbf

# Download elevation data and build hill-aware routing + elevation profiles.
# Set to False to skip (faster first build, no elevation chart).
VALHALLA_BUILD_ELEVATION=True

# Threads used for tile building and serving. Defaults to all cores.
#VALHALLA_SERVER_THREADS=4

# --- Map tiles -------------------------------------------------------------
# Optional self-hosted CyclOSM raster tile server. Leave unset to use the
# public CyclOSM servers (community-run; can be slow rendering new areas).
# Template must contain {z}/{x}/{y}, e.g.:
#   TILE_URL_CYCLOSM=http://192.168.2.78:8080/tile/{z}/{x}/{y}.png
#TILE_URL_CYCLOSM=

# --- Backend ---------------------------------------------------------------
# Internal URL the backend uses to reach Valhalla (compose service name).
VALHALLA_URL=http://valhalla:8002

# Port the app listens on (prod profile).
APP_PORT=17777

# --- Database and auth -----------------------------------------------------
# Postgres password for the bikegps database user. Change for prod.
POSTGRES_PASSWORD=bikegps

# Allow registrations beyond the first (admin) user. Default false.
SIGNUPS_ENABLED=false

# Set true when the app is served over HTTPS (prod behind a reverse proxy)
# so session cookies are marked Secure.
COOKIE_SECURE=false

# --- Optional OIDC single sign-on ------------------------------------------
# Works with any OIDC provider (Pocket ID, Authelia, Authentik, Keycloak...).
# All three of issuer/client-id/client-secret must be set to enable the
# "Continue with ..." button; unset keeps email+password only.
# External base URL of the app (used for the OIDC redirect URI).
#APP_URL=https://bike.example.com
#OIDC_ISSUER=https://id.example.com
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
#OIDC_PROVIDER_NAME=Pocket ID
# Register the client with callback URL: <APP_URL>/api/auth/oidc/callback
# SSO logins match existing accounts by email; new identities are only
# auto-provisioned when SIGNUPS_ENABLED=true.

# --- Wahoo Cloud API (optional) --------------------------------------------
# Register a developer app at https://developers.wahooligan.com (Sandbox
# environment, confidential app) with redirect URI:
#   <APP_URL>/api/wahoo/callback
# Sandbox works fully with your own Wahoo account; production approval is
# only needed when third parties use your instance. Unset hides all Wahoo
# UI and endpoints.
#WAHOO_CLIENT_ID=
#WAHOO_CLIENT_SECRET=
